# =============================================================================
# GlobeLens AI — Environment Variables Template
# =============================================================================
# Instructions:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in secrets   (never commit the .env file to version control)
#   3. Run:              docker-compose up --build
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=CHANGE_ME_to_a_long_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────────
POSTGRES_USER=globelens
POSTGRES_PASSWORD=globelens_secret
POSTGRES_DB=globelens_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://globelens:globelens_secret@db:5432/globelens_db

# ── Redis Stack ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:redis_secret@cache:6379/0

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://search:9200
ELASTICSEARCH_INDEX_EVENTS=globelens_events

# ── LLM Providers ────────────────────────────────────────────────────────────
# Choose one: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# ── Embedding Model ───────────────────────────────────────────────────────────
# OpenAI embedding model used by EmbeddingService
EMBEDDING_MODEL=text-embedding-3-small

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=GlobeLens AI

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
